# ── Required ─────────────────────────────────────────────────────────────────
# Your OpenAI API key. Never commit a real key here.
OPENAI_API_KEY=sk-...

# ── OpenAI Settings ───────────────────────────────────────────────────────────
# Model to use for structured extraction.
# Options: gpt-4o, gpt-4o-mini (default), gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# ── Crawling ──────────────────────────────────────────────────────────────────
# Maximum pages to crawl per domain (default: 8)
MAX_PAGES_PER_DOMAIN=8

# Maximum concurrent domain enrichment tasks (default: 2)
MAX_CONCURRENT_DOMAINS=2

# HTTP request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30

# Playwright page navigation timeout in seconds (default: 30)
PAGE_TIMEOUT=30

# Polite crawl delay between page requests in seconds (default: 1.0)
CRAWL_DELAY_SECONDS=1.0

# ── Content ───────────────────────────────────────────────────────────────────
# Maximum characters of evidence to send to the LLM (default: 40000)
MAX_CONTENT_CHARS=40000

# ── Browser ───────────────────────────────────────────────────────────────────
# Run Chromium headless (default: true)
HEADLESS=true

# ── Caching ───────────────────────────────────────────────────────────────────
# Enable local file cache for crawled pages (default: true)
CACHE_ENABLED=true

# Cache directory (default: cache)
CACHE_DIR=cache

# Cache TTL in hours (default: 24)
CACHE_TTL_HOURS=24

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
LOG_LEVEL=INFO

# Log format: text (human-readable) | json (structured) (default: text)
LOG_FORMAT=text

# ── Optional Search Provider ─────────────────────────────────────────────────
# Supplement crawled data with external search.
# Options: disabled (default) | tavily
SEARCH_PROVIDER=disabled

# Required only when SEARCH_PROVIDER=tavily
# TAVILY_API_KEY=tvly-...
